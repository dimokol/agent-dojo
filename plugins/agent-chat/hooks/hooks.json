{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|fork|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/server/wake.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 1728000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/prompt.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/server/wake.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 1728000
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/server/wake.sh",
            "async": true,
            "asyncRewake": true,
            "timeout": 1728000
          }
        ]
      }
    ]
  }
}
